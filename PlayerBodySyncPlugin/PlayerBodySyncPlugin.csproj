<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Version>1.0.0.0</Version>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <Product>HLVR Co-Op Mod - Player Body Sync Plugin</Product>
	  <Copyright>© 2024 Dayshower</Copyright>
	  <Description>Synchronizes player body preferences across clients for multiplayer visibility</Description>
	  <Company>Dayshower</Company>
  </PropertyGroup>
	<Target Name="CopyDLLs" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(ProjectDir)..\HLVRCoOpMod\bin\Release\plugins" />
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll;$(TargetDir)$(ProjectName).pdb" DestinationFolder="$(ProjectDir)..\HLVRCoOpMod\bin\Debug\plugins" />
	</Target>
	<ItemGroup>
	  <ProjectReference Include="..\HLVRCoOpModCore\HLVRCoOpModCore.csproj" />
	</ItemGroup>
</Project>
