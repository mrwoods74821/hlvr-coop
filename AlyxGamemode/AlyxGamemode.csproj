<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	  <Version>3.2.0.0</Version>
	  <Product>HLVR Co-Op Mod - Half-Life: Alyx Gamemode</Product>
	  <Copyright>© 2022 KiwifruitDev</Copyright>
	  <Description>Play Half-Life: Alyx cooperatively with up to 16 players!</Description>
	  <Company>KiwifruitDev</Company>
  </PropertyGroup>
	<Target Name="CopyDLLs" AfterTargets="Build">
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(ProjectDir)..\HLVRCoOpMod\bin\Release\gamemodes" />
		<Copy SourceFiles="$(TargetDir)$(ProjectName).dll;$(TargetDir)$(ProjectName).pdb" DestinationFolder="$(ProjectDir)..\HLVRCoOpMod\bin\Debug\gamemodes" />

		<Message Text="Copied build files" Importance="High" />
	</Target>
	<ItemGroup>
	  <PackageReference Include="Fleck" Version="1.2.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\HLVRCoOpModCore\HLVRCoOpModCore.csproj" />
	  <ProjectReference Include="..\HLVRCoOpMod\HLVRCoOpMod.csproj" />
	</ItemGroup>
</Project>
